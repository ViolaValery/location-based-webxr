{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "gps-plus-slam-app-framework/ar": ["../GpsPlusSlamJs_AppFramework/src/ar/index.ts"],
      "gps-plus-slam-app-framework/sensors": ["../GpsPlusSlamJs_AppFramework/src/sensors/index.ts"],
      "gps-plus-slam-app-framework/sensors/*": ["../GpsPlusSlamJs_AppFramework/src/sensors/*.ts"],
      "gps-plus-slam-app-framework/state": ["../GpsPlusSlamJs_AppFramework/src/state/index.ts"],
      "gps-plus-slam-app-framework/visualization": ["../GpsPlusSlamJs_AppFramework/src/visualization/index.ts"],
      "gps-plus-slam-app-framework/storage": ["../GpsPlusSlamJs_AppFramework/src/storage/index.ts"],
      "gps-plus-slam-app-framework": ["../GpsPlusSlamJs_AppFramework/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}

